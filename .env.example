# squat.watch — local secrets. This file is gitignored. Never commit it.
# Fill in the values; keep the variable names, the build prompt (section 13) and F11 expect them.

# ── name.com Core API v1 ─────────────────────────────────────────────────────
# Production: read-only calls (checkAvailability, search) plus the ONE production
# registration of the product's own domain in M0. 2FA must be enabled on the
# account before API tokens work. Token is shown once in Settings → API tokens.
NAMECOM_USERNAME=your-namecom-username
NAMECOM_TOKEN=
NAMECOM_BASE_URL=https://api.name.com

# Sandbox: all demo registrations and forwarding calls (F8). Username is your
# production username with "-test" appended; the sandbox token is listed on the
# same API tokens page. The test account carries account credit for purchases.
NAMECOM_SANDBOX_USERNAME=your-namecom-username-test
NAMECOM_SANDBOX_TOKEN=
NAMECOM_SANDBOX_BASE_URL=https://api.dev.name.com

# Hard cap for the single production purchase in M0 (USD). The script checks
# the checkAvailability price first and stops above this value.
NAMECOM_PROD_PURCHASE_CAP_USD=50
NAMECOM_PROD_DOMAIN_CANDIDATES=squat.watch,typo.watch,lookalike.watch

# Real registrant WHOIS contact — required only for the one production
# purchase (squatwatch/prod_register.py --confirm). name.com requires
# accurate registrant data by ICANN policy; never fill these with
# placeholder/fake values, and never let an agent invent them.
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_ZIP=
REGISTRANT_COUNTRY=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=

# ── SerpApi (F5: "appears in Google" badge) ──────────────────────────────────
SERPAPI_API_KEY=
# Per-scan cap protects the monthly quota; F12 caches results for 24h.
SERPAPI_MAX_QUERIES_PER_SCAN=10

# ── Anthropic (F6 one-line reasons, F9 notice polish) ────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# claude-opus-5 was the original choice; switched to sonnet-5 in Round 1
# revision after measuring opus-5 fail to complete a 7-card reasoning
# batch even at a 10s budget, while sonnet-5 succeeded 3/3 at 5.8-7.3s
# (examiner_report.md P1 finding; project_brief.md Section 6 names this
# exact swap as the pre-approved fix).

# ── RDAP / DNS (no keys; endpoints are public) ───────────────────────────────
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
DOH_RESOLVER_URL=https://cloudflare-dns.com/dns-query

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# 1 = serve every beat from cached seed snapshots (no external calls, no keys).
REPLAY_MODE=0
CACHE_TTL_SECONDS=86400
SQLITE_PATH=./data/squatwatch.db
# Comma-separated brands whose watch-mode diff always compares the committed
# seed pair, ignoring live scan rows entirely (B1) -- keeps the curated demo
# brand's "Since 14 Aug 2026: ..." story stable across rehearsal scans.
SNAPSHOT_FROZEN_BRANDS=devnetwork.com

# Shared cost-gate code for a live (non-replay) scan on the public
# deployment (Round 6, refinements/typo-watch-access-code-2026-08-26.md).
# Empty = gate off (local dev, tests, fresh clones unchanged by default).
# The real value is a Fly secret, chosen at deploy time, never committed
# here, and not derivable from public event info.
SCAN_ACCESS_CODE=
